# Copy to .env.local and fill in. Never commit a filled-in copy.
# "Browser?" for each variable is recorded in docs/SECRETS.md.
# Which variables are REQUIRED is declared in src/lib/env/registry.ts, per stage.

# The Supabase project URL. Browser-visible.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...). Browser-visible; RLS still gates every query.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (sb_secret_...). Carries BYPASSRLS. Server only. Never prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Absolute origin of this deployment, e.g. https://example.com. Used to build auth redirect URLs.
NEXT_PUBLIC_SITE_URL=

# Upstash Redis REST endpoint, for rate limiting. Server only.
UPSTASH_REDIS_REST_URL=

# Upstash Redis REST token. Server only.
UPSTASH_REDIS_REST_TOKEN=

# Sentry DSN, for error reporting. Server only: there is no browser Sentry. Optional; unset means
# no Sentry, and /api/version says so.
SENTRY_DSN=

# Sentry auth token, for uploading source maps at build time. Server/CI only. A Vercel SECRET.
SENTRY_AUTH_TOKEN=

# Sentry organisation and project slugs, for source map upload at build time. Not secret.
SENTRY_ORG=
SENTRY_PROJECT=

# VERCEL_GIT_COMMIT_SHA, VERCEL_GIT_COMMIT_REF and VERCEL_ENV are injected by Vercel
# automatically. They are not set here and must not be; /api/version reports them.

# NOTE: the Resend API key is deliberately absent. It is configured in the Supabase
# dashboard's SMTP settings and is never read by this application. See docs/SECRETS.md.
